; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=x86_64-unknown-linux-gnu < %s | FileCheck %s

; A tailcc callee pops GetAlignedArgumentStackSize(getStackSize()) bytes on
; return. The caller must assume the same amount: with a 16-byte-aligned stack
; argument (<4 x i32> below) and an argument area of 8 mod 16 (24 bytes here),
; aligning getAlignedCallFrameSize() instead gives 40, so a call left rsp 16
; bytes low and a tail call moved the return address 16 bytes too far.


define tailcc double @callee(ptr %p, double %a0, double %a1, double %a2, double %a3, double %a4, double %a5, double %a6, double %a7, <4 x i32> %v, double %x) noinline {
; CHECK-LABEL: callee:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movsd {{.*#+}} xmm0 = mem[0],zero
; CHECK-NEXT:    retq $24
  ret double %x
}

define double @call(ptr %p) nounwind {
; CHECK-LABEL: call:
; CHECK:       # %bb.0:
; CHECK-NEXT:    subq $24, %rsp
; CHECK-NEXT:    movabsq $4621256167635550208, %rax # imm = 0x4022000000000000
; CHECK-NEXT:    movq %rax, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    movaps %xmm0, (%rsp)
; CHECK-NEXT:    movsd {{.*#+}} xmm0 = [1.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm1 = [2.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm2 = [3.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm3 = [4.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm4 = [5.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm5 = [6.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm6 = [7.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm7 = [8.0E+0,0.0E+0]
; CHECK-NEXT:    callq callee@PLT
; CHECK-NEXT:    retq
  %r = call tailcc double @callee(ptr %p, double 1.0, double 2.0, double 3.0, double 4.0, double 5.0, double 6.0, double 7.0, double 8.0, <4 x i32> zeroinitializer, double 9.0)
  ret double %r
}

define tailcc double @tail(ptr %p) nounwind {
; CHECK-LABEL: tail:
; CHECK:       # %bb.0:
; CHECK-NEXT:    subq $40, %rsp
; CHECK-NEXT:    movabsq $4621256167635550208, %rax # imm = 0x4022000000000000
; CHECK-NEXT:    movq %rax, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movq {{[0-9]+}}(%rsp), %rax
; CHECK-NEXT:    xorps %xmm0, %xmm0
; CHECK-NEXT:    movaps %xmm0, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movq %rax, {{[0-9]+}}(%rsp)
; CHECK-NEXT:    movsd {{.*#+}} xmm0 = [1.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm1 = [2.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm2 = [3.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm3 = [4.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm4 = [5.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm5 = [6.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm6 = [7.0E+0,0.0E+0]
; CHECK-NEXT:    movsd {{.*#+}} xmm7 = [8.0E+0,0.0E+0]
; CHECK-NEXT:    addq $24, %rsp
; CHECK-NEXT:    jmp callee@PLT # TAILCALL
  %r = tail call tailcc double @callee(ptr %p, double 1.0, double 2.0, double 3.0, double 4.0, double 5.0, double 6.0, double 7.0, double 8.0, <4 x i32> zeroinitializer, double 9.0)
  ret double %r
}
