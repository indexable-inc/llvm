; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=aarch64-unknown-linux-gnu -O2 < %s | FileCheck %s --check-prefix=SDAG
; RUN: llc -mtriple=aarch64-unknown-linux-gnu -O0 -global-isel < %s | FileCheck %s --check-prefix=GISEL

; A caller that pops its own stack arguments on return (tailcc here: the 9th
; i64 arrives on the stack) cannot sibcall a C callee, which returns with a
; plain `ret` and leaves those 16 bytes on the stack. The call must stay a
; call followed by the caller's own `add sp, sp, #16; ret`.

declare void @c_callee(ptr)
declare tailcc void @tail_callee(ptr)

define tailcc void @pops_args(ptr %vm, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8) nounwind {
; SDAG-LABEL: pops_args:
; SDAG:       // %bb.0:
; SDAG-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
; SDAG-NEXT:    bl c_callee
; SDAG-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
; SDAG-NEXT:    add sp, sp, #16
; SDAG-NEXT:    ret
;
; GISEL-LABEL: pops_args:
; GISEL:       // %bb.0:
; GISEL-NEXT:    str x30, [sp, #-16]! // 8-byte Folded Spill
; GISEL-NEXT:    bl c_callee
; GISEL-NEXT:    ldr x30, [sp], #16 // 8-byte Folded Reload
; GISEL-NEXT:    add sp, sp, #16
; GISEL-NEXT:    ret
  tail call void @c_callee(ptr %vm)
  ret void
}

; No stack arguments: nothing to pop, so the sibcall stays.
define tailcc void @no_stack_args(ptr %vm, i64 %a1) nounwind {
; SDAG-LABEL: no_stack_args:
; SDAG:       // %bb.0:
; SDAG-NEXT:    b c_callee
;
; GISEL-LABEL: no_stack_args:
; GISEL:       // %bb.0:
; GISEL-NEXT:    b c_callee
  tail call void @c_callee(ptr %vm)
  ret void
}

; tailcc to tailcc is a guaranteed tail call, which already pops correctly.
define tailcc void @to_tailcc(ptr %vm, i64 %a1, i64 %a2, i64 %a3, i64 %a4, i64 %a5, i64 %a6, i64 %a7, i64 %a8) nounwind {
; SDAG-LABEL: to_tailcc:
; SDAG:       // %bb.0:
; SDAG-NEXT:    add sp, sp, #16
; SDAG-NEXT:    b tail_callee
;
; GISEL-LABEL: to_tailcc:
; GISEL:       // %bb.0:
; GISEL-NEXT:    add sp, sp, #16
; GISEL-NEXT:    b tail_callee
  tail call tailcc void @tail_callee(ptr %vm)
  ret void
}
