; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -passes=instcombine -S %s | FileCheck %s

; Simplifying the loop exit removes the backedge, so the phi folds to a
; constant before the deinterleave shuffles of it are revisited. The zext
; fold then saw a constant source with no use list and asserted (release
; builds looped forever).

define <8 x i16> @deinterleave_of_folded_constant(<4 x i32> %a, i32 %x) {
; CHECK-LABEL: @deinterleave_of_folded_constant(
; CHECK-NEXT:  entry:
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    br i1 false, label [[LOOP]], label [[EXIT:%.*]]
; CHECK:       exit:
; CHECK-NEXT:    ret <8 x i16> zeroinitializer
;
entry:
  br label %loop

loop:
  %p = phi <4 x i32> [ zeroinitializer, %entry ], [ %a, %loop ]
  %b = bitcast <4 x i32> %p to <16 x i8>
  %even = shufflevector <16 x i8> %b, <16 x i8> zeroinitializer, <8 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14>
  %even.ext = sext <8 x i8> %even to <8 x i16>
  %odd = shufflevector <16 x i8> %b, <16 x i8> zeroinitializer, <8 x i32> <i32 1, i32 3, i32 5, i32 7, i32 9, i32 11, i32 13, i32 15>
  %odd.ext = sext <8 x i8> %odd to <8 x i16>
  %sum = or <8 x i16> %even.ext, %odd.ext
  %v = insertelement <4 x i32> zeroinitializer, i32 %x, i32 0
  %vb = bitcast <4 x i32> %v to <16 x i8>
  %hi = shufflevector <16 x i8> %vb, <16 x i8> zeroinitializer, <8 x i32> <i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
  %hi.ext = sext <8 x i8> %hi to <8 x i16>
  %hi.even = shufflevector <8 x i16> %hi.ext, <8 x i16> zeroinitializer, <4 x i32> <i32 0, i32 2, i32 4, i32 6>
  %hi.even.ext = sext <4 x i16> %hi.even to <4 x i32>
  %hb = bitcast <4 x i32> %hi.even.ext to <16 x i8>
  %neg = icmp slt <16 x i8> %hb, zeroinitializer
  %mask = bitcast <16 x i1> %neg to i16
  %again = icmp ne i16 %mask, 0
  br i1 %again, label %loop, label %exit

exit:
  ret <8 x i16> %sum
}
